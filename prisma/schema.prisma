generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
}

model divera_user_sync_problems {
  id              String                           @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  last_name       String?                          @db.VarChar(255)
  first_name      String?                          @db.VarChar(255)
  divera_id       Int                              @unique(map: "divera_user_sync_problems_divera_id_pk")
  created_at      DateTime                         @default(now()) @db.DateTime(0)
  modified_at     DateTime                         @default(now()) @db.DateTime(0)
  solved          Boolean                          @default(false)
  solved_at       DateTime?                        @db.DateTime(0)
  solved_by       String?                          @db.VarChar(36)
  reason          divera_user_sync_problems_reason
  assigned_to     String?                          @db.VarChar(36)
  member_assigned members?                         @relation("divera_user_sync_problems_assigned_toTomembers", fields: [assigned_to], references: [id], map: "divera_user_sync_problems_assigned_fk")
  member_solved   members?                         @relation("divera_user_sync_problems_solved_byTomembers", fields: [solved_by], references: [id], map: "divera_user_sync_problems_solver_fk")

  @@index([assigned_to], map: "divera_user_sync_problems_assigned_fk")
  @@index([solved_by], map: "divera_user_sync_problems_solver_fk")
}

model event_participation {
  id        String  @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  member_id String  @db.VarChar(36)
  event_id  String  @db.VarChar(36)
  events    events  @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_participation_events_id_fk")
  members   members @relation(fields: [member_id], references: [id], onDelete: Cascade, map: "event_participation_member_fk")

  @@unique([event_id, member_id], map: "event_participation_pk")
  @@index([member_id], map: "event_participation_member_fk")
}

model event_responses {
  id                    String                                @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  event_id              String                                @db.VarChar(36)
  member_id             String                                @db.VarChar(36)
  planned_participation event_responses_planned_participation
  events                events                                @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_responses_events_fk")
  members               members                               @relation(fields: [member_id], references: [id], onDelete: Cascade, map: "event_responses_member_fk")

  @@unique([event_id, member_id], map: "event_responses__member_event_pk")
  @@index([member_id], map: "event_responses_member_fk")
}

model events {
  id                  String                @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  divera_id           Int?                  @unique(map: "events_divera_id_pk")
  name                String                @db.VarChar(255)
  start               DateTime              @db.DateTime(0)
  end                 DateTime              @db.DateTime(0)
  address             String?               @db.VarChar(255)
  draft               Boolean               @default(true)
  description         String?               @db.VarChar(2040)
  divera_sync         Boolean?              @default(true)
  modified_at         DateTime              @default(now()) @db.Timestamp(0)
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  source              events_source
  feueron_id          String?               @db.VarChar(10)
  status              events_status?
  type                events_type?
  created_by          String?               @db.VarChar(36)
  event_groups        event_groups[]
  event_participation event_participation[]
  event_responses     event_responses[]
  event_responsibles  event_responsibles[]
  event_shift         event_shift[]
  members             members?              @relation(fields: [created_by], references: [id], map: "events_members_id_fk")
  food_orders         food_orders[]

  @@index([created_by], map: "events_members_id_fk")
}

model feueron_training_mappings {
  id            String     @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  feueron_name  String     @unique(map: "feueron_training_mappings_feueron_name_pk") @db.VarChar(255)
  feueron_key   String?    @db.VarChar(50)
  training_id   String?    @db.VarChar(36)
  ignore        Boolean    @default(false)
  mapped_at     DateTime?  @db.DateTime(0)
  mapped_by     String?    @db.VarChar(36)
  member_mapped members?   @relation(fields: [mapped_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "feueron_training_mappings_members_id_fk")
  training      trainings? @relation(fields: [training_id], references: [id], map: "feueron_training_mappings_training_fk")

  @@index([training_id], map: "feueron_training_mappings_training_fk")
  @@index([mapped_by], map: "feueron_training_mappings_members_id_fk")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model group_permissions {
  group_id      String                 @default(dbgenerated("(uuid())")) @db.VarChar(36)
  permission_id String                 @db.VarChar(36)
  mode          group_permissions_mode
  added_by      String?                @db.VarChar(36)
  added_at      DateTime?              @default(now()) @db.DateTime(0)
  permission    permissions            @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "group_permissions_permissions_id_fk")
  group         groups                 @relation(fields: [group_id], references: [id], onDelete: Cascade, map: "group_roles_groups_id_fk")
  member        members?               @relation(fields: [added_by], references: [id], map: "group_roles_members_id_fk")

  @@id([group_id, permission_id, mode])
  @@unique([group_id, permission_id, mode], map: "group_permissions_pk")
  @@index([permission_id], map: "group_permissions_permissions_id_fk")
  @@index([added_by], map: "group_roles_members_id_fk")
}

model groups {
  id                String               @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name              String               @db.VarChar(100)
  type              groups_type          @default(other)
  created_at        DateTime             @default(now()) @db.DateTime(0)
  updated_at        DateTime             @default(now()) @db.DateTime(0)
  created_by        String?              @db.VarChar(36)
  updated_by        String?              @db.VarChar(36)
  active            Boolean              @default(true)
  ref               groups_ref?
  event_groups      event_groups[]
  group_member_logs group_member_logs[]
  group_permissions group_permissions[]
  member_created    members?             @relation("groups_created_byTomembers", fields: [created_by], references: [id], map: "groups_created_fk")
  member_updated    members?             @relation("groups_updated_byTomembers", fields: [updated_by], references: [id], map: "groups_updated_fk")
  group_members     group_members_view[]

  @@index([created_by], map: "groups_created_fk")
  @@index([updated_by], map: "groups_updated_fk")
}

model job_logs {
  id        String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  job_id    String        @db.VarChar(36)
  timestamp DateTime      @default(now()) @db.Timestamp(0)
  type      job_logs_type
  message   String        @db.Text
  jobs      jobs          @relation(fields: [job_id], references: [id], onDelete: Cascade, map: "job_logs_jobs_id_fk")

  @@index([job_id], map: "job_logs_jobs_id_fk")
}

model jobs {
  id                  String                @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  service_id          String                @db.VarChar(36)
  queued              DateTime              @default(now()) @db.DateTime(0)
  started             DateTime?             @db.DateTime(0)
  status              jobs_status?
  args                String?               @db.VarChar(255)
  finished            DateTime?             @db.DateTime(0)
  queued_by           String?               @db.VarChar(36)
  job_logs            job_logs[]
  member              members?              @relation(fields: [queued_by], references: [id], map: "jobs_queued_by_fk")
  service             services              @relation(fields: [service_id], references: [id], onDelete: Cascade, map: "jobs_services_id_fk")
  process_record_jobs process_record_jobs[]

  @@index([queued_by], map: "jobs_queued_by_fk")
  @@index([service_id], map: "jobs_services_id_fk")
}

model lockers {
  id                                   String    @id @db.VarChar(5)
  member_id                            String?   @db.VarChar(36)
  modified_by                          String?   @db.VarChar(36)
  modified_at                          DateTime? @default(now()) @db.Timestamp(0)
  members                              members?  @relation("lockers_member_idTomembers", fields: [member_id], references: [id], map: "lockers_members_fk")
  members_lockers_modified_byTomembers members?  @relation("lockers_modified_byTomembers", fields: [modified_by], references: [id], map: "lockers_members_id_fk")

  @@index([member_id], map: "lockers_members_fk")
  @@index([modified_by], map: "lockers_members_id_fk")
}

model member_permissions {
  member_id       String                  @db.VarChar(36)
  permission_id   String                  @db.VarChar(36)
  mode            member_permissions_mode
  added_by        String                  @db.VarChar(36)
  added_at        DateTime?               @default(now()) @db.DateTime(0)
  member_added_by members                 @relation("member_permissions_added_byTomembers", fields: [added_by], references: [id], onUpdate: Restrict, map: "member_permissions_members_id_fk")
  member          members                 @relation("member_permissions_member_idTomembers", fields: [member_id], references: [id], onDelete: Cascade, map: "member_permissions_members_id_fk_2")
  permission      permissions             @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "member_permissions_permissions_id_fk")

  @@id([permission_id, member_id, mode])
  @@index([member_id], map: "member_permissions_members_id_fk_2")
  @@index([added_by], map: "member_permissions_members_id_added_by_fk")
}

