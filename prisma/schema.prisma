model workflow_start_process_props {
  process_definition_id     String                                     @id @db.VarChar(36)
  cron                      String?                                    @db.VarChar(40)
  endpoint                  String?                                    @unique(map: "process_start_props_pk") @db.VarChar(100)
  context_mode              workflow_start_process_props_context_mode? @default(use)
  overwrite                 Boolean?
  unique_member_context     Boolean?
  unique_foreign_context    Boolean?
  unique_attributes_context Boolean?
  ref                       workflow_start_process_props_ref?          @unique(map: "process_start_props_pk_2")
  workflow_processes        workflow_processes                         @relation(fields: [process_definition_id], references: [id], onDelete: Cascade, map: "process_start_props_process_definitions_id_fk")
}

model workflow_start_workflow_props {
  process_id                                                                              String                                                @id @db.VarChar(36)
  trigger_process_id                                                                      String?                                               @db.VarChar(36)
  context_forward_option                                                                  workflow_start_workflow_props_context_forward_option?
  workflow_processes_workflow_start_workflow_props_trigger_process_idToworkflow_processes workflow_processes?                                   @relation("workflow_start_workflow_props_trigger_process_idToworkflow_processes", fields: [trigger_process_id], references: [id], map: "workflow_start_workflow_props_process_definitions_id_fk")
  workflow_processes_workflow_start_workflow_props_process_idToworkflow_processes         workflow_processes                                    @relation("workflow_start_workflow_props_process_idToworkflow_processes", fields: [process_id], references: [id], onDelete: Cascade, map: "workflow_start_workflow_props_process_definitions_id_fk_2")

  @@index([trigger_process_id], map: "workflow_start_workflow_props_process_definitions_id_fk")
}

model workflows {
  id                  String                @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name                String                @db.VarChar(50)
  active              Boolean               @default(true)
  parent_workflow_id  String?               @db.VarChar(36)
  workflow_executions workflow_executions[]
  workflow_processes  workflow_processes[]
  workflows           workflows?            @relation("workflowsToworkflows", fields: [parent_workflow_id], references: [id], map: "workflows_workflows_id_fk")
  other_workflows     workflows[]           @relation("workflowsToworkflows")

  @@index([parent_workflow_id], map: "workflows_workflows_id_fk")
}

